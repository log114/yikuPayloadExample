<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.YikuShoutApp" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 控制所有普通 TextView 的默认文字颜色 -->
        <item name="android:textViewStyle">@style/MyTextViewStyle</item>
        <!-- 统一 EditText 的文字颜色 -->
        <item name="editTextStyle">@style/MyEditTextStyle</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.YikuShoutApp.Dialog</item>
        <!-- 普通按键 -->
        <item name="android:buttonStyle">@style/MyButtonStyle</item>
        <!-- 显式声明 Dialog 按钮使用独立样式（覆盖任何可能的继承） -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="Theme.YikuShoutApp.Fullscreen" parent="Theme.YikuShoutApp">
<!--        <item name="android:actionBarStyle">@style/Widget.Theme.YikuShoutApp.ActionBar.Fullscreen-->
<!--        </item>-->
<!--        <item name="android:windowActionBarOverlay">true</item>-->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/window_bg</item>
    </style>

    <style name="Theme.YikuShoutApp.MainPage" parent="Theme.YikuShoutApp.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_layer</item>
        <!-- 让系统那层默认启动图标不可见 -->
<!--        <item name="android:statusBarColor">@android:color/transparent</item>-->
<!--        <item name="android:navigationBarColor">@android:color/transparent</item>-->

<!--        &lt;!&ndash; 禁止窗口半透明导致的黑闪 &ndash;&gt;-->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="ThemeOverlay.YikuShoutApp.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

    <style name="Theme.YikuShoutApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.YikuShoutApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.YikuShoutApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <!-- Base application theme. -->
    <!--    <style name="Base.Theme.YikuShoutApp" parent="Theme.Material3.DayNight.NoActionBar">-->
    <!--        &lt;!&ndash; Customize your light theme here. &ndash;&gt;-->
    <!--        &lt;!&ndash; <item name="colorPrimary">@color/my_light_primary</item> &ndash;&gt;-->
    <!--    </style>-->
</resources>