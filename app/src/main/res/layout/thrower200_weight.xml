<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thWeight"
    android:layout_width="500dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/throwerWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_indicator" />
            <TextView
                android:id="@+id/connectState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="@string/connection_status_notconnected"
                android:textSize="10sp"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_1"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:text=":"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/bombState_1"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/cannot_detonate"
                    android:textColor="@color/red"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_2"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:text=":"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/bombState_2"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/cannot_detonate"
                    android:textColor="@color/red"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_3"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:text=":"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/bombState_3"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/cannot_detonate"
                    android:textColor="@color/red"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_4"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="10dp"
                    android:text=":"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/bombState_4"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/cannot_detonate"
                    android:textColor="@color/red"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/statusRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/weight_1"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/weight_1"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:textColor="@color/white"
                    android:text="0 kg"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/weight_2"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/weight_2"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:textColor="@color/white"
                    android:text="0 kg"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="#383D40" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="visible">

            <Switch
                android:id="@+id/throwerSafetySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:text="@string/safety_switch"
                android:textColor="@color/white"
                android:switchPadding="4dp"
                android:track="@drawable/switch_track_bg"
                android:thumb="@drawable/switch_thumb"
                tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="left"
                    android:text="@string/height"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/height"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="left"
                    android:text="0m"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/detonationSettingsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/play_btn"
                    android:padding="0dp"
                    android:text="@string/detonation_settings"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/weightSettingBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/play_btn"
                    android:padding="0dp"
                    android:text="称重设置"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/throwerUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/play_btn"
                    android:padding="0dp"
                    android:text="@string/update"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/thrower_6_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/openAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open_all"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switchLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switchCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switchRight"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switch1"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/switch2"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switch3"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switch4"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switch5"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />

                    <Button
                        android:id="@+id/switch6"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/detonationSettingsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="@string/bomb_1"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/throwerAllowDetonationSwitch_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:text="@string/allow_detonation"
                android:textColor="@color/white"
                android:switchPadding="4dp"
                android:track="@drawable/switch_track_bg"
                android:thumb="@drawable/switch_thumb"
                tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="@string/bomb_2"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/throwerAllowDetonationSwitch_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:text="@string/allow_detonation"
                android:textColor="@color/white"
                android:switchPadding="4dp"
                android:track="@drawable/switch_track_bg"
                android:thumb="@drawable/switch_thumb"
                tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bombSettingRow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_3"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>
                <Switch
                    android:id="@+id/throwerAllowDetonationSwitch_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:text="@string/allow_detonation"
                    android:textColor="@color/white"
                    android:switchPadding="4dp"
                    android:track="@drawable/switch_track_bg"
                    android:thumb="@drawable/switch_thumb"
                    tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/bomb_4"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>
                <Switch
                    android:id="@+id/throwerAllowDetonationSwitch_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:text="@string/allow_detonation"
                    android:textColor="@color/white"
                    android:switchPadding="4dp"
                    android:track="@drawable/switch_track_bg"
                    android:thumb="@drawable/switch_thumb"
                    tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="@string/detonate_height"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/detonateHeight"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/white"
                android:background="@drawable/edittext_border"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="start"
                android:text="m"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="@string/current_height"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/currentHeight"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/white"
                android:background="@drawable/edittext_border"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="left"
                android:text="m"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
        <Button
            android:id="@+id/OKBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/play_btn"
            android:text="@string/ok"
            android:textColor="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/weightSettingsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="标定重量："
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/calibrationWeight"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:inputType="numberDecimal"
                android:text="0"
                android:textColor="@color/white"
                android:background="@drawable/edittext_border"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:text="kg"
                android:textColor="@color/white"
                android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="visible">
            <Button
                android:id="@+id/calibration1Btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/play_btn"
                android:text="标定3号"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/calibration2Btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/play_btn"
                android:text="标定4号"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/peelBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/play_btn"
                android:text="去皮"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="visible">
            <Button
                android:id="@+id/factoryResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/play_btn"
                android:text="恢复出厂设置"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/weightSettingBackBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/default_btn"
                android:text="返回"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/promptView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="@string/confirm_open"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_horizontal"
            android:visibility="visible">
            <Button
                android:id="@+id/promptOkBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/play_btn"
                android:text="@string/ok"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/promptCancelBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/default_btn"
                android:text="@string/cancel"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/updateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="@string/isUpdate"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_horizontal"
            android:visibility="visible">
            <Button
                android:id="@+id/updateOkBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/play_btn"
                android:text="@string/ok"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/updateCancelBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/default_btn"
                android:text="@string/cancel"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>