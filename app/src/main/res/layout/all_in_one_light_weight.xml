<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speakerWeight"
    android:layout_width="360dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/connectState"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:textAlignment="textEnd"
                android:layout_weight="1"
                android:text="@string/not_connected"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_bottom_dash_line"
            android:visibility="visible"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:gravity="center_vertical"
                android:visibility="visible"
                tools:ignore="UselessParent">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/searchlight"
                    android:textSize="18sp"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:ignore="UselessParent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:visibility="visible"
                        tools:ignore="UselessParent">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/lighting"
                            android:textSize="14sp"
                            android:textColor="@color/white" />

                        <Button
                            android:id="@+id/light_open_btn"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:padding="0dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/play_btn"
                            android:text="@string/open"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:ignore="ButtonStyle" />

                        <Button
                            android:id="@+id/light_close_btn"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:padding="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/play_btn"
                            android:text="@string/close"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:ignore="ButtonStyle" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:visibility="visible"
                        tools:ignore="UselessParent">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="10dp"
                            android:text="@string/flash_lamp"
                            android:textSize="14sp"
                            android:textColor="@color/white" />

                        <Button
                            android:id="@+id/flash_open_btn"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:padding="0dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/play_btn"
                            android:text="@string/open"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:ignore="ButtonStyle" />

                        <Button
                            android:id="@+id/flash_close_btn"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:padding="0dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/play_btn"
                            android:text="@string/close"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:ignore="ButtonStyle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:gravity="center_vertical"
                android:visibility="visible"
                tools:ignore="UselessParent">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/luminance"
                    android:textAlignment="textEnd"
                    android:textSize="13sp"
                    android:textColor="@color/white" />

                <SeekBar
                    android:id="@+id/luminance_seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:minHeight="2dp"
                    android:maxHeight="2dp"
                    android:progressDrawable="@drawable/bg_adjust_seek_bar"
                    android:thumb="@drawable/bg_seek_bar_thumb"
                    android:max="30"
                    android:progress="0" />

                <TextView
                    android:id="@+id/luminance_text"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:text="0"
                    android:textSize="13sp"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">

            <TextView
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:text="@string/red_and_blue"
                android:textSize="18sp"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    tools:ignore="UselessParent">

                    <Button
                        android:id="@+id/redAndBlue_open_btn"
                        android:layout_width="100dp"
                        android:layout_height="30dp"
                        android:padding="0dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/play_btn"
                        android:text="@string/open"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="ButtonStyle" />

                    <Button
                        android:id="@+id/redAndBlue_close_btn"
                        android:layout_width="100dp"
                        android:layout_height="30dp"
                        android:padding="0dp"
                        android:layout_marginStart="40dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/play_btn"
                        android:text="@string/close"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="ButtonStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    tools:ignore="UselessParent">

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/red_blue_mode"
                        android:textSize="18sp"
                        android:textColor="@color/white" />

                    <LinearLayout
                        android:id="@+id/mode_selector_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/boder"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/current_mode_text"
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/white" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:text="@string/pitch_angle"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/pitch_seek_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="100"
                android:progress="30" />

            <TextView
                android:id="@+id/pitch_text"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="0°"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>