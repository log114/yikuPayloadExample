<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deWeight"
    android:layout_width="380dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/slowDescentDevice200Weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        tools:ignore="UselessParent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <Switch
                android:id="@+id/safetySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1"
                android:scaleY="1"
                android:text="@string/safety_switch"
                android:textColor="@color/white"
                tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml" />
            <TextView
                android:id="@+id/connectState"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/connection_status_notconnected"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/peakedText"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:text='@string/not_peaked'
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/weightTitle"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text='@string/weight'
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/weightText"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text='0 kg'
                android:textColor="@color/white" />
            <ImageButton
                android:id="@+id/resetToZeroBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="重量清零"
                android:src="@drawable/image_btn_reset_to_zero"
                android:scaleType="centerInside"
                android:background="@drawable/image_btn"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:paddingHorizontal="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text='@string/speed'
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/speedText"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text='0 m/s'
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text='@string/rope_length'
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/ropeLengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text='0 m'
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text='@string/horizontal_swing_angle'
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/swingAngleText"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text='0°'
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:paddingHorizontal="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text='@string/hook_status'
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/hookStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text='@string/not_connected'
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text='@string/hook_battery_level'
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/hookBatteryLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text='0%'
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text='@string/by_speed'
                android:textColor="@color/white" />
            <EditText
                android:id="@+id/upSpeedInput"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:text="10"
                android:textColor="@color/white"
                android:background="@drawable/boder"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text='m/min (0~60)'
                android:textColor="@color/white" />
            <ImageButton
                android:id="@+id/upBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="上升"
                android:src="@drawable/image_btn_up"
                android:scaleType="centerInside"
                android:background="@drawable/image_btn"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text='@string/by_speed'
                android:textColor="@color/white" />
            <EditText
                android:id="@+id/downSpeedInput"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:text="20"
                android:textColor="@color/white"
                android:background="@drawable/boder"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text='m/min (0~60)'
                android:textColor="@color/white" />
            <ImageButton
                android:id="@+id/downBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="下降"
                android:src="@drawable/image_btn_down"
                android:scaleType="centerInside"
                android:background="@drawable/image_btn"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text='@string/by_length'
                android:textColor="@color/white" />
            <EditText
                android:id="@+id/lengthInput"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/white"
                android:background="@drawable/boder"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text='m (0~100)'
                android:textColor="@color/white" />
            <ImageButton
                android:id="@+id/startBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="启动"
                android:src="@drawable/image_btn_start"
                android:scaleType="centerInside"
                android:background="@drawable/image_btn"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

