        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <Button
                android:id="@+id/warningLightBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="@string/warning_light"
                android:background="@drawable/play_btn"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/hookBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="8dp"
                android:text="@string/hook_switch"
                android:background="@drawable/play_btn"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/stopBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="8dp"
                android:text="@string/stop"
                android:background="@drawable/play_btn"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="visible">
            <Button
                android:id="@+id/urgentResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="@string/reset"
                android:background="@drawable/danger_btn"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/urgentStopBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="8dp"
                android:text="@string/urgent_stop"
                android:background="@drawable/danger_btn"
                android:textColor="@color/white"/>
            <Button
                android:id="@+id/urgentFuseBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="8dp"
                android:text="@string/fuse"
                android:background="@drawable/danger_btn"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/prompt_box"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text='@string/confirm_fuse'
            android:textColor="@color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text='@string/fuse_prompt'
            android:textColor="@color/white" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:visibility="visible">
            <Button
                android:id="@+id/btn_ok"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/play_btn"
                android:text="@string/ok"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/play_btn"
                android:text="@string/cancel"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>