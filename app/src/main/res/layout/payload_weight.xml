<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shoutComp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/shoutView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/yk_shout_model"
        android:minWidth="300dp"
        android:orientation="vertical"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:paddingHorizontal="4dp"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/windowTitle"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:gravity="start"
                android:textSize="16sp"
                android:text="@string/unitree_control"
                android:textColor="@color/shout_font_color" />
            <ImageView
                android:id="@+id/lockBtn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/unlock"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/shout_view_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:minWidth="300dp"
            android:orientation="horizontal" />

    </LinearLayout>
</LinearLayout>