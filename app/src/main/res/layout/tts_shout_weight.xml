<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TtsShoutWeight">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_indicator" />
        <TextView
            android:id="@+id/realTimeShoutConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/connection_status_notconnected"
            android:textSize="10sp"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible">
        <TextView
            android:id="@+id/temperature"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/temperature"
            android:textColor="@color/white" />
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/normal_temperature"
            android:textColor="@color/white" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="#383D40" />

    <EditText
        android:id="@+id/tts_text"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:autofillHints="speak_text"
        android:background="@drawable/edittext_border"
        android:gravity="top"
        android:hint="@string/place_input_text"
        android:inputType="text"
        android:minLines="4"
        android:textColor="@color/white"
        android:textColorHint="#9EABB2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:theme="@style/My_CheckBox">
        <RadioButton
            android:id="@+id/btn_man_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="@string/male_voice"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/btn_woman_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="@string/female_voice"/>
    </RadioGroup>
    <Switch
        android:id="@+id/tts_loop_playback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="@string/loop"
        android:textColor="@color/white"
        android:switchPadding="4dp"
        android:track="@drawable/switch_track_bg"
        android:thumb="@drawable/switch_thumb"
        tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:text="@string/adjust_volume"
            android:textColor="@color/white" />

        <SeekBar
            android:id="@+id/volume_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="2dp"
            android:maxHeight="2dp"
            android:progressDrawable="@drawable/bg_adjust_seek_bar"
            android:thumb="@drawable/bg_seek_bar_thumb"
            android:max="100"
            android:progress="30" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/speechRateLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/adjust_speechRate"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white" />

        <SeekBar
            android:id="@+id/speech_rate_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:minHeight="2dp"
            android:maxHeight="2dp"
            android:progressDrawable="@drawable/bg_adjust_seek_bar"
            android:thumb="@drawable/bg_seek_bar_thumb"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@+id/tts_play"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/play_btn"
            android:text="@string/tts_play"
            android:textColor="#ffffff" />
        <Button
            android:id="@+id/tts_stop"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/danger_btn"
            android:text="@string/stop"
            android:textColor="#ffffff" />
    </LinearLayout>

</LinearLayout>