<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speakerWeight"
    android:layout_width="500dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_bottom_dash_line"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <Button
                android:id="@+id/real_time_speak_btn"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="24dp"
                android:background="@drawable/play_btn"
                android:text="@string/start_speak"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/play_alarm"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:background="@drawable/danger_btn"
                android:text="@string/play_alarm"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle" />

            <TextView
                android:id="@+id/connectState"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:textAlignment="textEnd"
                android:layout_weight="1"
                android:text="@string/not_connected"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_bottom_dash_line"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <TextView
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:text="@string/tts"
                android:textSize="18sp"
                android:textColor="@color/white" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="UselessParent">
                <EditText
                    android:id="@+id/tts_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:autofillHints="speak_text"
                    android:background="@drawable/edittext_border"
                    android:hint="@string/place_input_text"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textColorHint="@color/white" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    tools:ignore="UselessParent">
                    <RadioGroup
                        android:id="@+id/radioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:theme="@style/My_CheckBox">
                        <RadioButton
                            android:id="@+id/btn_man_voice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:text="@string/male_voice"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/btn_woman_voice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:text="@string/female_voice"/>
                    </RadioGroup>
                    <CheckBox
                        android:id="@+id/tts_loop_playback_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:text="@string/loop_playback"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:theme="@style/My_CheckBox">
                    </CheckBox>
                    <Button
                        android:id="@+id/tts_play"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:padding="0dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/play_btn"
                        android:text="@string/play"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="ButtonStyle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <TextView
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:text="@string/play_audio"
                android:textSize="18sp"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/audio_play"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/play_btn"
                android:text="@string/play"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle" />
            <Button
                android:id="@+id/audio_stopPlay"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:background="@drawable/play_btn"
                android:text="@string/stop"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle" />
            <Button
                android:id="@+id/audio_loopPlay"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:background="@drawable/play_btn"
                android:text="@string/loop"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:visibility="visible"
                tools:ignore="UselessParent">
                <Button
                    android:id="@+id/addRecordBtn"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:padding="0dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/play_btn"
                    android:text="@string/add_video"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />

                <Button
                    android:id="@+id/del_audio"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:padding="0dp"
                    android:background="@drawable/danger_btn"
                    android:text="@string/del_video"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:background="@drawable/boder"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <ListView
                android:id="@+id/record_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:text="@string/volume"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="100"
                android:progress="30" />

            <TextView
                android:id="@+id/volumeText"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="30%"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:text="@string/pitch_angle"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/pitch_seek_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="900"
                android:progress="0" />

            <TextView
                android:id="@+id/pitchText"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="0°"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>