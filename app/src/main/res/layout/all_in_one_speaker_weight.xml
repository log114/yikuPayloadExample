<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speakerWeight"
    android:layout_width="450dp"
    android:layout_height="245dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_indicator" />
        <TextView
            android:id="@+id/connectState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/connection_status_notconnected"
            android:textSize="10sp"
            android:textColor="@color/white" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="#383D40" />

    <LinearLayout
        android:id="@+id/speakerMainPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        tools:ignore="UselessParent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="5dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:textAlignment="textStart"
                android:text="@string/shouting_and_alarms"
                android:textSize="13sp"
                android:textColor="@color/white" />
            <Button
                android:id="@+id/real_time_speak_btn"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/play_btn"
                android:text="@string/start_speak"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle"
                />
            <Button
                android:id="@+id/play_alarm"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:padding="0dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/play_btn"
                android:text="@string/play_alarm"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:ignore="ButtonStyle"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:visibility="visible"
                tools:ignore="UselessParent">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    android:textAlignment="textStart"
                    android:text="@string/tts"
                    android:textSize="13sp"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/tts_play"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:padding="0dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/play_btn"
                    android:text="@string/play"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle"
                    />

                <Button
                    android:id="@+id/tts_setting_btn"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:padding="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/play_btn"
                    android:text="@string/setting"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="visible"
            android:gravity="start"
            tools:ignore="UselessParent">

            <TextView
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:text="@string/audio_file"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="UselessParent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    tools:ignore="UselessParent">
                    <TextView
                        android:id="@+id/audio_file_name_text"
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textColor="@color/white"
                        android:background="@drawable/boder"
                        android:scrollHorizontally="true" />
                    <Button
                        android:id="@+id/open_fileList_btn"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:padding="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/play_btn"
                        android:text="@string/list"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="ButtonStyle" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    tools:ignore="UselessParent">
                    <Button
                        android:id="@+id/audio_play_btn"
                        android:layout_width="100dp"
                        android:layout_height="30dp"
                        android:padding="0dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/play_btn"
                        android:text="@string/play"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="ButtonStyle" />
                    <CheckBox
                        android:id="@+id/audio_loop_playback_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:text="@string/loop_playback"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:theme="@style/My_CheckBox">
                    </CheckBox>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="86dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:text="@string/volume"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="100"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:progress="30"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb" />

            <TextView
                android:id="@+id/volumeText"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="30%"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="86dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:text="@string/pitch_angle"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/pitch_seek_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="900"
                android:progress="0"
                android:visibility="visible"/>
            <TextView
                android:id="@+id/pitchText"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="0°"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/speakerSecondPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:ignore="UselessParent">
        <LinearLayout
            android:id="@+id/tts_setting_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="UselessParent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible"
                tools:ignore="UselessParent">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/content"
                    android:textSize="13sp"
                    android:textColor="@color/white" />
                <EditText
                    android:id="@+id/tts_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="speak_text"
                    android:background="@drawable/edittext_border"
                    android:hint="@string/place_input_text"
                    android:inputType="textMultiLine"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lines="5"
                    android:textColorHint="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                tools:ignore="UselessParent">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/play"
                    android:textSize="13sp"
                    android:textColor="@color/white" />
                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:theme="@style/My_CheckBox">
                    <RadioButton
                        android:id="@+id/btn_man_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:text="@string/male_voice"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/btn_woman_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:text="@string/female_voice"/>
                </RadioGroup>
                <CheckBox
                    android:id="@+id/tts_loop_playback_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:text="@string/loop_playback"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:theme="@style/My_CheckBox">
                </CheckBox>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:visibility="visible"
                tools:ignore="UselessParent">
                <Button
                    android:id="@+id/tts_back_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/default_btn"
                    android:text="@string/back"
                    android:textColor="@color/white"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/audio_file_list_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="UselessParent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:background="@drawable/boder"
                android:visibility="visible"
                tools:ignore="UselessParent">
                <ListView
                    android:id="@+id/record_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:visibility="visible"
                tools:ignore="UselessParent">
                <Button
                    android:id="@+id/addRecordBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/play_btn"
                    android:text="@string/add_video"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />

                <Button
                    android:id="@+id/del_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/danger_btn"
                    android:text="@string/del_video"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />

                <Button
                    android:id="@+id/audio_back_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/default_btn"
                    android:text="@string/back"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    tools:ignore="ButtonStyle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>