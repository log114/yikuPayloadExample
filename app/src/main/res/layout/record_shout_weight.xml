<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    tools:context=".RecordShoutWeight">

    <!-- 添加底部区域的锚点View -->
    <View
        android:id="@+id/bottom_anchor"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:visibility="invisible" />

    <ListView
        android:id="@+id/record_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_anchor"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/bottom_anchor"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible">
            <TextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="@string/temperature"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/normal_temperature"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="5dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="@string/adjust_volume"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/volume_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="100"
                android:progress="30" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginRight="8dp">
            <Button
                android:id="@+id/addRecordBtn"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/play_btn"
                android:text="@string/add_video"
                android:textColor="#fff" />

            <Button
                android:id="@+id/del_audio"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/play_btn"
                android:text="@string/del_video"
                android:textColor="#fff" />

            <Button
                android:id="@+id/stop_audio"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/play_btn"
                android:text="@string/stop_audio"
                android:textColor="#fff" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>