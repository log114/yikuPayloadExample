<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/allInOneFpvWeight"
    android:layout_width="450dp"
    android:layout_height="245dp">

    <LinearLayout
        android:id="@+id/fpv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp"
        android:orientation="vertical"
        android:visibility="visible"
        tools:ignore="UselessParent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/edittext_border"
            android:padding="0dp"
            tools:ignore="UselessParent">
            <LinearLayout
                android:id="@+id/playerParentView"
                android:layout_width="368dp"
                android:layout_height="207dp"
                android:layout_gravity="center_horizontal">
                <!-- 视频播放区域（底层） -->
                <TextureView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <!-- 控制按钮区域（顶层） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:layout_marginEnd="4dp"
                android:visibility="visible">
                <ImageView
                    android:id="@+id/flip_btn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="翻转视频画面180度"
                    android:src="@drawable/fpv_flip" />
                <ImageView
                    android:id="@+id/enlarge_btn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="全屏或恢复悬浮窗状态"
                    android:src="@drawable/picture_in_picture" />
                <ImageView
                    android:id="@+id/setting_btn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="设置推流地址"
                    android:src="@drawable/setting" />
            </LinearLayout>
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#383D40" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:ignore="UselessParent">
            <TextView
                android:layout_width="100dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:text="@string/pitch_angle"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <SeekBar
                android:id="@+id/pitch_seek_bar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/bg_adjust_seek_bar"
                android:thumb="@drawable/bg_seek_bar_thumb"
                android:max="900"
                android:progress="0" />

            <TextView
                android:id="@+id/pitch_text"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:text="0°"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#CC1E1E1E"
        android:padding="20dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置拉流地址"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_rtsp_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:hint="请输入RTSP地址"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_border"
            android:padding="10dp"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_save_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                android:layout_marginEnd="30dp"
                android:textColor="@color/white"
                android:background="@drawable/play_btn"/>

            <Button
                android:id="@+id/btn_cancel_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="@color/white"
                android:background="@drawable/cancel_btn"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>