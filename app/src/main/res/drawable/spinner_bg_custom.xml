<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第一层：带边框和圆角的背景 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#333333" /> <!-- 边框内的填充色，这里用深灰色 -->
            <stroke
                android:width="1dp"
                android:color="#FFFFFF" /> <!-- 边框颜色，白色 -->
            <corners android:radius="4dp" /> <!-- 圆角弧度 -->
        </shape>
    </item>
    <!-- 第二层：右侧的下拉箭头图标 -->
    <!-- 注意：@drawable/ic_arrow_drop_down_white 需要您提供一个白色的箭头图片 -->
    <item
        android:drawable="@drawable/ic_arrow_drop_down"
        android:gravity="end|center_vertical"
        android:width="24dp"
    android:height="24dp"
    android:right="8dp" />
</layer-list>